<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.1.0</Version>
    <Author>Shadowstar</Author>
    <Name>Starflow</Name>
    <Punchline>Read the stars, set your course. When the realm changes, your setup follows.</Punchline>
    <Description>Conditional setups that follow you around Eorzea. Switch game settings, commands, online status, Glamourer designs, Penumbra mods, plugin collections, and Lifestream travel by zone, duty, housing, party, job, schedule, weather, or chat.</Description>
    <RepoUrl>https://github.com/ShadowstarIO/Starflow</RepoUrl>
    <PackageProjectUrl>https://github.com/ShadowstarIO/Starflow</PackageProjectUrl>
    <IconUrl>https://raw.githubusercontent.com/ShadowstarIO/Starflow/star/images/icon.png</IconUrl>
    <Tags>starflow;flow;triggers;conditions;profiles;settings;commands;glamourer;penumbra;lifestream;housing;status</Tags>
    <InternalName>Starflow</InternalName>
    <ApplicableVersion>any</ApplicableVersion>
    <DalamudApiLevel>15</DalamudApiLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="Exists('..\\images\\icon.png')">
    <Content Include="..\\images\\icon.png" Link="images\\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\\images\\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\\images\\icon.svg')">
    <Content Include="..\\images\\icon.svg" Link="images\\icon.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

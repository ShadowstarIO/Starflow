<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.0.0</Version>
    <Author>Shadowstar</Author>
    <Name>Flow</Name>
    <Punchline>Set up a flow. When it matches, it does the rest.</Punchline>
    <Description>A graph of When, Do, Until, and After cards. Conditions read zone, duty, housing address, group size, schedule, weather, mount, job, and loaded plugins. Actions write game settings, run commands and repeated macros, set the search comment and online status, switch plugin collections, apply Glamourer designs, and change Penumbra mod state and options. Slotted actions put back what they replaced when the flow stops.</Description>
    <RepoUrl>https://github.com/ShadowstarIO/Flow</RepoUrl>
    <PackageProjectUrl>https://github.com/ShadowstarIO/Flow</PackageProjectUrl>
    <IconUrl>https://raw.githubusercontent.com/ShadowstarIO/Flow/main/images/icon.png</IconUrl>
    <Tags>flow;conditions;settings;commands;penumbra;glamourer</Tags>
    <InternalName>Flow</InternalName>
    <ApplicableVersion>any</ApplicableVersion>
    <DalamudApiLevel>15</DalamudApiLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="Exists('..\\images\\icon.png')">
    <Content Include="..\\images\\icon.png" Link="images\\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\\images\\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\\images\\icon.svg')">
    <Content Include="..\\images\\icon.svg" Link="images\\icon.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
